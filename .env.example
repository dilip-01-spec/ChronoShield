# Where the ChronoShield FastAPI gateway lives.
# "/backend" uses the Vite dev/preview proxy (no CORS changes needed on the backend).
# For a deployed build, set the full URL instead, e.g. https://api.example.com
VITE_API_BASE_URL=/backend

# Target of the dev proxy above.
VITE_PROXY_TARGET=http://127.0.0.1:8000

# Optional: replace the native 3D district field in the hero with a Spline scene.
# The MotionSites "Sentinel AI" cube wall is:
# VITE_SPLINE_SCENE=https://prod.spline.design/Slk6b8kz3LRlKiyk/scene.splinecode
VITE_SPLINE_SCENE=
